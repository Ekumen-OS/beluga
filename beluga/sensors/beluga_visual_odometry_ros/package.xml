<?xml version="1.0"?>
<package format="3">
  <name>beluga_visual_odometry_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper for Beluga stereo visual odometry.</description>
  <maintainer email="ignacio.bugueno@creativa77.com.ar">ignacio.bugueno</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>beluga_visual_odometry</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>